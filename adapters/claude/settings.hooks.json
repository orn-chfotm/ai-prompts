{
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "pa",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/subagent-stop-flag.sh\"" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/check-pa-callback.sh\"" }
        ]
      }
    ]
  }
}
